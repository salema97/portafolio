---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/sections/Hero.astro';
import About from '../../components/sections/About.astro';
import Stats from '../../components/sections/Stats.astro';
import Experience from '../../components/sections/Experience.astro';
import Projects from '../../components/sections/Projects.astro';
import Skills from '../../components/sections/Skills.astro';
import Certifications from '../../components/sections/Certifications.astro';
import Contact from '../../components/sections/Contact.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}
---

<Layout>
  <Header />
  <main id="main-content" class="flex-grow flex flex-col items-center w-full">
    <Hero />

    <div class="page-container relative z-20 mt-10 sm:mt-12 md:mt-6 md:-mt-10 lg:-mt-14">
      <Stats />
    </div>

    <div class="section-band section-band--alt w-full">
      <Experience />
    </div>

    <div class="section-band section-band--glow w-full">
      <Projects />
    </div>

    <div class="section-band section-band--alt w-full">
      <Skills />
    </div>

    <div class="section-band w-full">
      <Certifications />
    </div>

    <div class="section-band section-band--alt w-full">
      <About />
    </div>

    <div class="section-band section-band--glow w-full pb-8">
      <Contact />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const lang = document.documentElement.lang;
  if (lang) {
    localStorage.setItem('preferred-lang', lang);
  }
</script>
