---
import { FaArrowUp, FaGithub, FaLinkedin, FaWhatsapp } from "react-icons/fa";
import { MdCall, MdEmail } from "react-icons/md";
import { getLangFromUrl, getTranslations } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-auto relative overflow-hidden border-t border-border/60">
  <div
    class="absolute inset-0 bg-gradient-to-t from-primary/5 via-transparent to-transparent pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div class="page-container relative z-[1] py-12 sm:py-16">
    <div class="flex flex-col md:flex-row items-center justify-between gap-10">
      <div class="text-center md:text-left" data-reveal>
        <a
          href={`/${lang}/`}
          class="font-display text-2xl md:text-3xl font-bold text-foreground hover:text-primary transition-colors"
        >
          Steven Lema
        </a>
        <p class="text-sm text-muted-foreground mt-3 max-w-xs">
          {t.footer.copyright.replace("2025", String(year))}
        </p>
      </div>

      <div class="flex gap-3" role="list" data-reveal data-reveal-delay="2">
        <a
          href="https://github.com/salema97"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="icon-btn"
          role="listitem"
        >
          <FaGithub className="w-5 h-5" />
        </a>
        <a
          href="https://linkedin.com/in/salema97"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="icon-btn"
          role="listitem"
        >
          <FaLinkedin className="w-5 h-5" />
        </a>
        <a href="mailto:contactos@salema.dev" aria-label="Email" class="icon-btn" role="listitem">
          <MdEmail className="w-5 h-5" />
        </a>
        <a
          href="https://wa.me/593988237106"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="icon-btn"
          role="listitem"
        >
          <FaWhatsapp className="w-5 h-5" />
        </a>
        <a href="tel:+593988237106" aria-label="Phone" class="icon-btn" role="listitem">
          <MdCall className="w-5 h-5" />
        </a>
      </div>
    </div>

    <div class="flex justify-center mt-10" data-reveal data-reveal-delay="3">
      <a
        href={`/${lang}/`}
        data-scroll-to="hero"
        class="btn-outline !min-h-11 gap-2"
      >
        <FaArrowUp className="text-sm" aria-hidden="true" />
        {t.footer.backToTop}
      </a>
    </div>
  </div>
</footer>
