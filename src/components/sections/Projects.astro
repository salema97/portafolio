---
import { getLangFromUrl, getTranslations } from "../../i18n";
import ProjectGallery from "../ProjectGallery";
import SectionHeader from "../SectionHeader.astro";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const proj = t.projects;
---

<section id="work" class="section-shell">
  <SectionHeader title={proj.sectionTitle} />

  <ProjectGallery
    client:visible
    projects={proj.items}
    labels={{
      viewAll: proj.viewAll,
      filterAll: proj.filterAll,
      showMore: proj.showMore,
      showLess: proj.showLess,
      categories: proj.categories,
      platformKinds: proj.platformKinds,
      filterByTech: proj.filterByTech,
      projectCount: proj.projectCount,
      emptyState: proj.emptyState,
      viewDetails: proj.viewDetails,
      demoAvailable: proj.demoAvailable,
      demoUnavailable: proj.demoUnavailable,
      demoPrivate: proj.demoPrivate,
      viewDemo: proj.viewDemo,
      sourceKinds: proj.sourceKinds,
      close: proj.close,
      galleryLabel: proj.galleryLabel,
      videoLabel: proj.videoLabel,
      imageCount: proj.imageCount,
    }}
  />
</section>
