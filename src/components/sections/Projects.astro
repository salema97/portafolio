---
import { FaRocket } from "react-icons/fa";
import { getLangFromUrl, getTranslations } from "../../i18n";
import ProjectGallery from "../ProjectGallery";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const proj = t.projects;
---

<section id="work" class="py-20 px-4 w-full max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="text-center mb-16">
    <h2
      class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white flex items-center justify-center gap-3"
    >
      <FaRocket className="text-primary text-3xl md:text-4xl" />
      {proj.sectionTitle}
    </h2>
    <div class="w-20 h-1 bg-primary mx-auto mt-4 rounded-full"></div>
  </div>

  <!-- Interactive React Gallery with filtering -->
  <ProjectGallery
    client:load
    projects={proj.items}
    labels={{
      viewAll: proj.viewAll,
      filterAll: proj.filterAll,
      showMore: proj.showMore,
      showLess: proj.showLess,
    }}
  />
</section>
