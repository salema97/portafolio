---
import { FaCloud, FaHtml5, FaServer } from "react-icons/fa";
import { getLangFromUrl, getTranslations } from "../../i18n";
import SectionHeader from "../SectionHeader.astro";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const skills = t.skills;

const iconMap = {
  html: FaHtml5,
  dns: FaServer,
  settings_system_daydream: FaCloud,
};
---

<section id="skills" class="section-shell">
  <SectionHeader title={skills.sectionTitle} subtitle={skills.sectionSubtitle} />

  <div class="grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
    {
      skills.categories.map((cat: any, i: number) => {
        const Icon = iconMap[cat.icon as keyof typeof iconMap];
        return (
          <article
            class="card-premium p-6 md:p-8 relative overflow-hidden group"
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
          >
            <div
              class="absolute -bottom-8 -right-8 text-primary/5 group-hover:text-primary/15 transition-colors duration-500 pointer-events-none"
              aria-hidden="true"
            >
              {Icon && <Icon style={{ fontSize: "8rem" }} />}
            </div>

            <div class="relative">
              <div class="flex items-center gap-3 mb-8">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary/25 to-primary/5 flex items-center justify-center shrink-0 border border-primary/20">
                  {Icon && <Icon className="text-primary text-xl" aria-hidden="true" />}
                </div>
                <h3 class="font-display text-xl font-bold text-foreground">{cat.name}</h3>
              </div>

              <ul class="space-y-5">
                {cat.skills.map((skill: any) => (
                  <li>
                    <div class="flex justify-between mb-2">
                      <span class="text-sm font-medium text-foreground">{skill.name}</span>
                      <span class="text-xs text-primary font-mono font-bold tabular-nums">
                        {skill.level}%
                      </span>
                    </div>
                    <div
                      class="w-full h-2.5 rounded-full bg-muted/80 overflow-hidden"
                      role="progressbar"
                      aria-valuenow={skill.level}
                      aria-valuemin={0}
                      aria-valuemax={100}
                      aria-label={`${skill.name} proficiency`}
                    >
                      <div
                        class="h-full rounded-full bg-gradient-to-r from-primary via-primary-glow to-accent-warm skill-bar"
                        style={`width: ${skill.level}%`}
                      />
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
