---
import { getLangFromUrl, getTranslations } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
---

<section class="w-full max-w-7xl mx-auto px-4 py-20" id="skills">
  <div class="flex flex-col items-center text-center gap-2 mb-16">
    <h2 class="text-3xl md:text-4xl font-bold dark:text-white text-slate-900">{t.skills.title}</h2>
    <div class="h-1 w-20 bg-primary rounded-full"></div>
    <p class="dark:text-slate-400 text-slate-500 mt-4 max-w-2xl">{t.skills.subtitle}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {t.skills.categories.map((category) => (
      <div class="glass-panel p-8 rounded-2xl relative overflow-hidden">
        {/* Background decorative icon */}
        <div class="absolute -right-4 -top-4 dark:text-slate-800/30 text-slate-200/50">
          <span class="material-symbols-outlined text-[150px]">{category.bgIcon}</span>
        </div>

        <h3 class="text-xl font-bold dark:text-white text-slate-900 mb-6 flex items-center gap-2 relative z-10">
          <span class="material-symbols-outlined text-primary">{category.icon}</span>
          {category.name}
        </h3>

        <div class="space-y-6 relative z-10">
          {category.items.map((skill) => (
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-sm font-medium dark:text-slate-300 text-slate-600">{skill.name}</span>
                <span class="text-sm font-medium text-primary">{skill.level}%</span>
              </div>
              <div class="w-full dark:bg-slate-700 bg-slate-200 rounded-full h-2">
                <div
                  class="bg-primary h-2 rounded-full shadow-[0_0_10px_rgba(19,91,236,0.6)] skill-bar"
                  style={`width: ${skill.level}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
