---
import { getLangFromUrl, getTranslations } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const skills = t.skills;
---

<section id="skills" class="py-20 px-4 w-full max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
      {skills.sectionTitle}
    </h2>
    <div class="w-20 h-1 bg-primary mx-auto mt-4 rounded-full"></div>
    <p class="text-gray-600 dark:text-gray-400 mt-4 max-w-2xl mx-auto">{skills.sectionSubtitle}</p>
  </div>

  <!-- Categories Grid -->
  <div class="grid md:grid-cols-3 gap-8">
    {skills.categories.map((cat: any) => (
      <div class="glass-panel rounded-xl p-6 hover:border-primary/30 transition-all duration-300 relative overflow-hidden group">
        {/* Decorative bg icon */}
        <span
          class="material-symbols-outlined absolute -bottom-4 -right-4 text-primary/5 group-hover:text-primary/10 transition-colors"
          style="font-size:6rem;"
        >
          {cat.icon}
        </span>

        <div class="relative">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-primary/20 flex items-center justify-center">
              <span class="material-symbols-outlined text-primary">{cat.icon}</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">{cat.name}</h3>
          </div>

          <div class="space-y-4">
            {cat.skills.map((skill: any) => (
              <div>
                <div class="flex justify-between mb-1.5">
                  <span class="text-sm text-gray-700 dark:text-gray-300">{skill.name}</span>
                  <span class="text-xs text-primary font-medium">{skill.level}%</span>
                </div>
                <div class="w-full h-2 rounded-full bg-gray-200 dark:bg-gray-800 overflow-hidden">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-primary to-primary-glow skill-bar"
                    style={`width: ${skill.level}%`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
