---
import ParallaxScene from "../ParallaxScene.astro";
import { FaArrowRight, FaGithub, FaLinkedin, FaWhatsapp } from "react-icons/fa";
import { MdCall, MdEmail } from "react-icons/md";
import { getLangFromUrl, getTranslations } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const hero = t.hero;
---

<section
  id="hero"
  class="section-shell section-shell--hero relative overflow-x-clip"
>
  <div
    class="relative z-10 grid w-full grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-12 lg:gap-20"
  >
    <div class="order-1 flex flex-col gap-6 sm:gap-8">
      <div
        class="hero-badge glass-panel inline-flex w-fit max-w-full items-center gap-2.5 rounded-full px-3 py-2.5 text-sm sm:px-4"
      >
        <span class="hero-badge-dot relative flex h-2.5 w-2.5" aria-hidden="true">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-500 opacity-75 motion-reduce:animate-none"
          ></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-red-600"></span>
        </span>
        <span class="text-sm font-semibold leading-snug text-foreground">{hero.badge}</span>
      </div>

      <div class="space-y-3 sm:space-y-5">
        <p
          class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-primary/90 sm:text-sm sm:tracking-[0.3em]"
        >
          {hero.greeting}
        </p>
        <h1 class="font-display font-extrabold leading-[0.95] tracking-tight">
          <span
            class="hero-gradient-text block text-[clamp(2.25rem,9vw,5rem)] text-balance lg:text-glow"
          >
            {hero.name}
          </span>
          <span
            class="hero-outline-text mt-2 block text-[clamp(1.75rem,5vw,3rem)] leading-[1.1] pb-0.5"
          >
            {hero.headlineOutline}
          </span>
        </h1>
        <p
          class="max-w-xl text-base leading-relaxed text-muted-foreground text-pretty sm:text-lg md:max-w-lg"
        >
          {hero.description}
        </p>
      </div>

      <div class="btn-stack">
        <a href={`/${lang}/`} data-scroll-to="work" class="btn-primary group">
          {hero.cta1}
          <FaArrowRight
            className="text-base transition-transform duration-200 group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </a>
        <a href={`/${lang}/`} data-scroll-to="contact" class="btn-outline">
          {hero.cta2}
        </a>
      </div>

      <div
        class="hero-socials flex flex-wrap justify-center gap-2.5 border-t border-border/50 pt-6 sm:justify-start"
        role="list"
      >
        <a
          href="https://github.com/salema97"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="icon-btn"
          role="listitem"
        >
          <FaGithub className="h-5 w-5" />
        </a>
        <a
          href="https://linkedin.com/in/salema97"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="icon-btn"
          role="listitem"
        >
          <FaLinkedin className="h-5 w-5" />
        </a>
        <a href="mailto:contactos@salema.dev" aria-label="Email" class="icon-btn" role="listitem">
          <MdEmail className="h-5 w-5" />
        </a>
        <a
          href="https://wa.me/593988237106"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="icon-btn"
          role="listitem"
        >
          <FaWhatsapp className="h-5 w-5" />
        </a>
        <a href="tel:+593988237106" aria-label="Phone" class="icon-btn" role="listitem">
          <MdCall className="h-5 w-5" />
        </a>
      </div>
    </div>

    <div class="order-2 flex justify-center md:justify-end" data-reveal data-reveal-delay="2">
      <div class="relative w-full max-w-[280px] md:max-w-[300px] lg:max-w-[360px]">
        <ParallaxScene variant="hero" />

        <div class="hero-float relative z-[1]">
          <div class="hero-photo-glow absolute inset-0 -z-10 scale-95" aria-hidden="true"></div>

          <div
            class="hero-photo-frame relative aspect-[4/5] overflow-hidden rounded-2xl bg-background sm:rounded-[1.75rem]"
          >
            <img
              src="/images/PHOTO.webp"
              alt="Steven Lema, Full-Stack Software Engineer"
              class="h-full w-full object-cover object-top"
              width="360"
              height="450"
              loading="eager"
              fetchpriority="high"
            />
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background via-background/45 to-transparent"
              aria-hidden="true"
            >
            </div>

            <div
              class="card-premium absolute bottom-3 left-3 right-3 z-[2] flex items-center gap-3 px-4 py-3 sm:bottom-4 sm:left-4 sm:right-4 sm:px-5 sm:py-4"
            >
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/20 font-mono text-sm font-bold text-primary sm:h-11 sm:w-11"
              >
                &gt;_
              </div>
              <div class="min-w-0">
                <p class="truncate text-xs text-muted-foreground">{hero.statusTitle}</p>
                <p class="truncate text-sm font-semibold text-foreground">{hero.statusText}</p>
              </div>
            </div>
          </div>

          <div
            class="absolute -right-2 -top-3 z-[3] rounded-xl bg-gradient-to-r from-accent-warm to-primary px-3 py-1.5 font-display text-xs font-bold tracking-widest text-primary-foreground sm:-right-3 sm:-top-4 sm:px-4"
          >
            FS
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
