---
import { getLangFromUrl, getTranslations } from "../../i18n";
import SectionHeader from "../SectionHeader.astro";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const exp = t.experience;
---

<section id="experience" class="section-shell">
  <SectionHeader title={exp.sectionTitle} align="left" />

  <!-- Mobile + tablet: vertical timeline -->
  <div class="relative space-y-8 md:hidden">
    <div
      class="absolute bottom-2 left-[11px] top-2 w-0.5 bg-gradient-to-b from-primary via-accent-warm/50 to-transparent"
      aria-hidden="true"
    >
    </div>
    {
      exp.items.map((item: any, i: number) => (
        <article class="relative pl-10" data-reveal data-reveal-delay={String((i % 3) + 1)}>
          <div
            class="absolute left-0 top-6 h-3.5 w-3.5 rounded-full bg-primary ring-4 ring-background shadow-glow-sm"
            aria-hidden="true"
          >
          </div>
          <time class="mb-2 block font-mono text-sm font-semibold text-primary tabular-nums">
            {item.date}
          </time>
          <div class="card-premium p-5 sm:p-6">
            <h3 class="font-display text-lg font-bold text-foreground sm:text-xl">{item.role}</h3>
            <p class="mt-1 font-semibold text-primary">{item.title}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">
              {item.description}
            </p>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
              {item.tags.map((tag: string) => (
                <li>
                  <span class="rounded-md border border-primary/25 bg-primary/10 px-2.5 py-1 font-mono text-xs font-medium text-primary">
                    {tag}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>

  <!-- Desktop: alternating timeline -->
  <div class="relative hidden md:block">
    <div
      class="absolute bottom-2 left-1/2 top-2 w-px -translate-x-px bg-gradient-to-b from-primary via-accent-warm/50 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div class="space-y-14 lg:space-y-16">
      {
        exp.items.map((item: any, i: number) => (
          <article
            class={`relative grid grid-cols-2 gap-8 lg:gap-12 ${i % 2 === 1 ? "[&>div:first-child]:order-2" : ""}`}
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
          >
            <div
              class="absolute left-1/2 top-8 z-10 h-4 w-4 -translate-x-1/2 rounded-full bg-primary shadow-glow-sm ring-4 ring-background"
              aria-hidden="true"
            />
            <div class={`pr-8 lg:pr-10 ${i % 2 === 0 ? "text-right" : "col-start-2 pl-8 lg:pl-10"}`}>
              <time class="font-mono text-sm font-semibold text-primary tabular-nums">{item.date}</time>
            </div>
            <div
              class={`${i % 2 === 0 ? "col-start-2 -mt-8 pl-8 lg:pl-10" : "-mt-8 pr-8 lg:pr-10"}`}
            >
              <div class="card-premium p-6 lg:p-8">
                <h3 class="font-display text-xl font-bold text-foreground lg:text-2xl">{item.role}</h3>
                <p class="mt-1 font-semibold text-primary">{item.title}</p>
                <p class="mt-4 text-sm leading-relaxed text-muted-foreground lg:text-base">
                  {item.description}
                </p>
                <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
                  {item.tags.map((tag: string) => (
                    <li>
                      <span class="rounded-md border border-primary/25 bg-primary/10 px-3 py-1 font-mono text-xs font-medium text-primary">
                        {tag}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
