---
import { getLangFromUrl, getTranslations } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const items = t.experience.items;
---

<section class="w-full max-w-4xl mx-auto px-4 py-20">
  <div class="flex flex-col items-start gap-2 mb-12">
    <h2 class="text-3xl md:text-4xl font-bold dark:text-white text-slate-900 flex items-center gap-3">
      <span class="text-primary material-symbols-outlined text-4xl">history_edu</span>
      {t.experience.title}
    </h2>
    <div class="h-1 w-20 bg-primary rounded-full"></div>
  </div>

  <div class="relative space-y-8 pl-8 md:pl-0">
    <!-- Vertical Line (desktop) -->
    <div class="absolute left-8 md:left-[50%] top-0 bottom-0 w-px bg-gradient-to-b from-primary via-slate-800 to-transparent -translate-x-1/2 hidden md:block"></div>

    {items.map((item, index) => {
      const isEven = index % 2 === 0;
      const isFirst = index === 0;

      return (
        <div class="relative md:grid md:grid-cols-2 gap-12 items-center group">
          {/* Desktop: Date/Title side */}
          {isEven ? (
            <div class="hidden md:block text-right pr-8">
              <span class={`font-bold text-xl ${isFirst ? 'text-primary' : 'dark:text-slate-500 text-slate-400'}`}>{item.period}</span>
              <h3 class="dark:text-white text-slate-900 text-2xl font-bold mt-1">{item.role}</h3>
              <p class="dark:text-slate-400 text-slate-500 font-medium">{item.company}</p>
            </div>
          ) : null}

          {/* Dot */}
          <div class={`absolute left-[-2rem] md:left-[50%] top-0 md:top-1/2 w-4 h-4 dark:bg-background-dark bg-background-light border-2 ${isFirst ? 'border-primary shadow-[0_0_10px_rgba(19,91,236,0.8)]' : 'dark:border-slate-600 border-slate-300 group-hover:border-primary'} rounded-full -translate-x-1/2 md:-translate-y-1/2 z-10 transition-colors`}></div>

          {/* Mobile: Period shown above card */}
          <div class="md:hidden mb-2">
            <span class={`font-bold text-sm ${isFirst ? 'text-primary' : 'dark:text-slate-500 text-slate-400'}`}>{item.period}</span>
          </div>

          {/* Card */}
          <div class={`glass-panel p-6 rounded-xl hover:border-primary/50 transition-colors ${!isEven ? 'order-2 md:order-1' : ''}`}>
            <div class="md:hidden mb-4">
              <h3 class="dark:text-white text-slate-900 text-xl font-bold">{item.role}</h3>
              <p class="dark:text-slate-400 text-slate-500 font-medium">{item.company}</p>
            </div>
            <p class={`dark:text-slate-300 text-slate-600 text-sm leading-relaxed mb-4 ${!isEven ? 'text-left' : ''}`}>
              {item.description}
            </p>
            <div class={`flex flex-wrap gap-2 ${!isEven ? 'justify-start md:justify-end' : ''}`}>
              {item.tags.map((tag: string) => (
                <span class="px-2 py-1 dark:bg-surface-dark bg-slate-100 border dark:border-white/10 border-slate-200 rounded text-xs dark:text-slate-400 text-slate-500">{tag}</span>
              ))}
            </div>
          </div>

          {/* Desktop: Date/Title side (odd items) */}
          {!isEven ? (
            <div class="hidden md:block pl-8 order-1 md:order-2">
              <span class={`font-bold text-xl ${isFirst ? 'text-primary' : 'dark:text-slate-500 text-slate-400'}`}>{item.period}</span>
              <h3 class="dark:text-white text-slate-900 text-2xl font-bold mt-1">{item.role}</h3>
              <p class="dark:text-slate-400 text-slate-500 font-medium">{item.company}</p>
            </div>
          ) : null}
        </div>
      );
    })}
  </div>
</section>
