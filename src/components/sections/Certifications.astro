---
import { getLangFromUrl, getTranslations } from "../../i18n";
import SectionHeader from "../SectionHeader.astro";
import CertificationsCarousel from "./Certifications.tsx";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const certs = t.certifications;
---

<section id="certifications" class="section-shell max-w-7xl">
  <SectionHeader title={certs.sectionTitle} align="left" />

  <div data-reveal data-reveal-delay="2">
    <CertificationsCarousel
      client:visible
      items={certs.items}
      title={certs.sectionTitle}
      verifyText={certs.verify}
    />
  </div>
</section>
