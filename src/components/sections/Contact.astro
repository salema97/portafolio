---
import { getLangFromUrl, getTranslations } from '../../i18n/index';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
---

<section class="w-full bg-gradient-to-b dark:from-surface-dark/50 from-slate-50 dark:to-background-dark to-white py-20 px-4 relative overflow-hidden" id="contact">
  <!-- Decorative circle -->
  <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-primary/5 rounded-full blur-[80px] -z-10 pointer-events-none"></div>

  <div class="max-w-4xl mx-auto glass-panel p-8 md:p-12 rounded-3xl border border-primary/20 shadow-2xl">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold dark:text-white text-slate-900 mb-4">{t.contact.title}</h2>
      <p class="dark:text-slate-400 text-slate-500">{t.contact.subtitle}</p>
    </div>

    <form class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label class="text-sm font-medium dark:text-slate-300 text-slate-600 ml-1">{t.contact.name}</label>
          <input
            type="text"
            placeholder={t.contact.namePlaceholder}
            class="w-full px-4 py-3 dark:bg-background-dark bg-white border dark:border-slate-700 border-slate-300 rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary dark:text-white text-slate-900 dark:placeholder-slate-600 placeholder-slate-400 transition-all"
          />
        </div>
        <div class="space-y-2">
          <label class="text-sm font-medium dark:text-slate-300 text-slate-600 ml-1">{t.contact.email}</label>
          <input
            type="email"
            placeholder={t.contact.emailPlaceholder}
            class="w-full px-4 py-3 dark:bg-background-dark bg-white border dark:border-slate-700 border-slate-300 rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary dark:text-white text-slate-900 dark:placeholder-slate-600 placeholder-slate-400 transition-all"
          />
        </div>
      </div>

      <div class="space-y-2">
        <label class="text-sm font-medium dark:text-slate-300 text-slate-600 ml-1">{t.contact.subject}</label>
        <select class="w-full px-4 py-3 dark:bg-background-dark bg-white border dark:border-slate-700 border-slate-300 rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary dark:text-white text-slate-900 transition-all">
          {t.contact.subjectOptions.map((option: string) => (
            <option>{option}</option>
          ))}
        </select>
      </div>

      <div class="space-y-2">
        <label class="text-sm font-medium dark:text-slate-300 text-slate-600 ml-1">{t.contact.message}</label>
        <textarea
          rows="4"
          placeholder={t.contact.messagePlaceholder}
          class="w-full px-4 py-3 dark:bg-background-dark bg-white border dark:border-slate-700 border-slate-300 rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary dark:text-white text-slate-900 dark:placeholder-slate-600 placeholder-slate-400 transition-all resize-none"
        ></textarea>
      </div>

      <button
        type="button"
        class="w-full py-4 bg-primary hover:bg-blue-600 text-white font-bold rounded-lg shadow-glow transition-all hover:-translate-y-1"
      >
        {t.contact.send}
      </button>
    </form>
  </div>
</section>
