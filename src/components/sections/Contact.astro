---
import { getLangFromUrl, getTranslations } from "../../i18n";
import ContactForm from "../ContactForm";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const contact = t.contact;
---

<section id="contact" class="py-20 px-4 w-full max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white">
      {contact.sectionTitle}
    </h2>
    <div class="w-20 h-1 bg-primary mx-auto mt-4 rounded-full"></div>
    <p class="text-gray-600 dark:text-gray-400 mt-4 max-w-xl mx-auto">
      {contact.sectionSubtitle}
    </p>
  </div>

  <div class="max-w-2xl mx-auto">
    <ContactForm
      client:visible
      labels={{
        name: contact.nameLabel,
        email: contact.emailLabel,
        subject: contact.subjectLabel,
        message: contact.messageLabel,
        submit: contact.submit,
      }}
      placeholders={{
        name: contact.namePlaceholder,
        email: contact.emailPlaceholder,
        subject: contact.subjectPlaceholder,
        message: contact.messagePlaceholder,
      }}
      subjectOptions={contact.subjectOptions}
    />
  </div>
</section>
