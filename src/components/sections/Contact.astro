---
import { getLangFromUrl, getTranslations } from "../../i18n";
import ContactForm from "../ContactForm";
import SectionHeader from "../SectionHeader.astro";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const contact = t.contact;
---

<section id="contact" class="section-shell">
  <SectionHeader title={contact.sectionTitle} subtitle={contact.sectionSubtitle} />

  <div class="max-w-2xl mx-auto w-full" data-reveal data-reveal-delay="2">
    <ContactForm
      client:visible
      labels={{
        name: contact.nameLabel,
        email: contact.emailLabel,
        subject: contact.subjectLabel,
        message: contact.messageLabel,
        submit: contact.submit,
      }}
      placeholders={{
        name: contact.namePlaceholder,
        email: contact.emailPlaceholder,
        subject: contact.subjectPlaceholder,
        message: contact.messagePlaceholder,
      }}
      subjectOptions={contact.subjectOptions}
    />
  </div>
</section>
