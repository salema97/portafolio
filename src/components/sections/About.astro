---
import { getLangFromUrl, getTranslations } from "../../i18n";
import SectionHeader from "../SectionHeader.astro";
import { MdBadge, MdEmail, MdLocationOn, MdSchool } from "react-icons/md";

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const about = t.about;
const details = about.details;
---

<section id="about" class="section-shell">
  <SectionHeader title={about.sectionTitle} align="left" />

  <div class="grid items-start gap-10 sm:gap-12 lg:grid-cols-[minmax(260px,320px)_1fr] lg:gap-16">
    <aside class="mx-auto flex w-full max-w-[320px] flex-col gap-6 lg:mx-0" data-reveal>
      <div class="relative w-full">
        <div class="hero-photo-glow absolute inset-2 -z-10" aria-hidden="true"></div>
        <div
          class="hero-photo-frame relative aspect-square overflow-hidden rounded-[1.75rem] bg-background"
        >
          <img
            src="/images/PHOTO.webp"
            alt="Steven Lema"
            class="h-full w-full object-cover object-top"
            width="320"
            height="320"
            loading="lazy"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/70 via-transparent to-transparent"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>

      <div class="card-premium w-full p-5 sm:p-6">
        <h3 class="mb-4 font-mono text-xs font-semibold uppercase tracking-widest text-primary">
          {about.interestsTitle}
        </h3>
        <ul class="flex flex-wrap gap-2">
          {
            about.interests.map((interest: string) => (
              <li>
                <span class="rounded-full border border-primary/25 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">
                  {interest}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>

    <div class="space-y-10" data-reveal data-reveal-delay="2">
      <div class="space-y-5 text-base leading-relaxed text-muted-foreground md:text-lg">
        <p class="text-pretty font-display text-xl font-semibold leading-snug text-foreground/90 md:text-2xl">
          {about.bio1}
        </p>
        <p>{about.bio2}</p>
        <p class="border-l-2 border-primary pl-4 font-semibold text-primary">{about.bio3}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="card-surface flex items-center gap-4 p-5">
          <MdLocationOn className="shrink-0 text-2xl text-primary" aria-hidden="true" />
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{details.locationLabel}</p>
            <p class="mt-1 text-sm font-semibold text-foreground">{details.location}</p>
          </div>
        </div>
        <div class="card-surface flex items-center gap-4 p-5">
          <MdSchool className="shrink-0 text-2xl text-primary" aria-hidden="true" />
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{details.universityLabel}</p>
            <p class="mt-1 text-sm font-semibold text-foreground">{details.university}</p>
          </div>
        </div>
        <div class="card-surface flex items-center gap-4 p-5">
          <MdBadge className="shrink-0 text-2xl text-primary" aria-hidden="true" />
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{details.degreeLabel}</p>
            <p class="mt-1 text-sm font-semibold text-foreground">{details.degree}</p>
          </div>
        </div>
        <div class="card-surface flex items-center gap-4 p-5">
          <MdEmail className="shrink-0 text-2xl text-primary" aria-hidden="true" />
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{details.emailLabel}</p>
            <a
              href={`mailto:${details.email}`}
              class="mt-1 inline-block text-sm font-semibold text-primary hover:underline"
            >
              {details.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
