---
import { getLangFromUrl, getTranslations } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const stats = t.stats;
---

<section class="py-10 px-4 w-full">
  <div class="max-w-6xl mx-auto glass-panel rounded-2xl p-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.items.map((stat: any) => (
        <div class="text-center">
          <p class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-primary to-primary-glow bg-clip-text text-transparent text-glow">
            {stat.value}
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
