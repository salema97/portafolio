---
import { getLangFromUrl, getTranslations } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const stats = t.stats;
---

<section class="w-full max-w-6xl mx-auto" aria-label="Statistics">
  <div class="card-premium grid grid-cols-2 gap-6 p-6 sm:gap-8 sm:p-8 md:grid-cols-4 md:gap-8 md:p-10">
    {
      stats.items.map((stat: { value: string; label: string }, i: number) => (
        <div
          class="text-center md:text-left group"
          data-reveal
          data-reveal-delay={String((i % 4) + 1)}
        >
          <p class="font-display text-3xl font-bold hero-gradient-text tabular-nums transition-transform duration-300 group-hover:scale-105 origin-left sm:text-4xl md:text-5xl">
            {stat.value}
          </p>
          <p class="text-sm text-muted-foreground mt-2 font-medium">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>
