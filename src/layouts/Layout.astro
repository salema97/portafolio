---
import "../styles/global.css";
import ScrollProgress from "../components/ScrollProgress.astro";

import {
  getLangFromUrl,
  getTranslations,
  getAlternateLocaleUrl,
  type Lang,
} from "../i18n/index";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const { title = t.site.title, description = t.site.description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const altLang: Lang = lang === "en" ? "es" : "en";
const alternateURL = new URL(getAlternateLocaleUrl(Astro.url, altLang), Astro.site);
const defaultURL = new URL("/en/", Astro.site);
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=JetBrains+Mono:wght@500;600&family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang={lang} href={canonicalURL.href} />
    <link rel="alternate" hreflang={altLang} href={alternateURL.href} />
    <link rel="alternate" hreflang="x-default" href={defaultURL.href} />

    <meta name="theme-color" content="#080808" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f9f7f6" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL("/images/PHOTO.webp", Astro.site)}
    />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "es" ? "en_US" : "es_ES"}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/images/PHOTO.webp", Astro.site)}
    />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        if (stored === "light") {
          document.documentElement.classList.remove("dark");
        } else if (stored === "dark") {
          document.documentElement.classList.add("dark");
        } else if (window.matchMedia("(prefers-color-scheme: light)").matches) {
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col font-body">
    <ScrollProgress />
    <div class="page-mesh" aria-hidden="true"></div>
    <div class="page-grid" aria-hidden="true"></div>
    <div class="page-grain" aria-hidden="true"></div>
    <a
      href={`/${lang}/`}
      data-scroll-to="main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-primary focus:text-primary-foreground"
    >
      Skip to main content
    </a>
    <slot />
    <script src="../scripts/portfolio-motion.ts"></script>
  </body>
</html>
